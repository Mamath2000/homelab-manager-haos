#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Homelab Manager agent. First start: the install token (hub agent URL, pinned key
# of the hub, single-use code) is exchanged for a certificate, kept in /data/agent.
# A different token later enrolls the agent again (after a revocation, a new hub...).
# ==============================================================================
set -euo pipefail

DIR=/data/agent
STATE=/data/state
mkdir -p "${DIR}" "${STATE}"
chmod 700 "${DIR}"

token=$(bashio::config 'install_token' '')
token_sum=""
[[ -n "${token}" ]] && token_sum=$(printf '%s' "${token}" | sha256sum | cut -d' ' -f1)

if [[ ! -s "${DIR}/agent.crt" ]] || { [[ -n "${token_sum}" ]] && [[ "${token_sum}" != "$(cat "${DIR}/token.sha256" 2>/dev/null)" ]]; }; then
    [[ -n "${token}" ]] || bashio::exit.nok "Aucun jeton : copie-le depuis Homelab Manager (Ajouter un hôte › Home Assistant OS) dans la configuration de l'application."
    # base64url without padding
    b64=$(printf '%s' "${token}" | tr '_-' '/+')
    while (( ${#b64} % 4 )); do b64="${b64}="; done
    json=$(printf '%s' "${b64}" | base64 -d 2>/dev/null) || bashio::exit.nok "Jeton illisible : recopie-le en entier."
    hub=$(jq -r '.hub // empty' <<<"${json}")
    pin=$(jq -r '.pin // empty' <<<"${json}")
    code=$(jq -r '.code // empty' <<<"${json}")
    # host name, IPv4 or [IPv6], and port ("]" first in the bracket expression)
    hub_re='^https://[][A-Za-z0-9.:-]+$'
    [[ "${hub}" =~ ${hub_re} && "${pin}" =~ ^[A-Za-z0-9+/=]+$ && "${code}" =~ ^[A-Za-z0-9_-]+$ ]] \
        || bashio::exit.nok "Jeton invalide : recopie-le en entier."

    bashio::log.info "Enrôlement auprès de ${hub}"
    # -k: no CA / host name check, the pinned key of the hub replaces it
    curl -fsSk --pinnedpubkey "sha256//${pin}" "${hub}/agent/ca.pem" -o "${DIR}/ca.pem.new" \
        || bashio::exit.nok "Hub injoignable, ou sa clé ne correspond pas au jeton (${hub})."
    mv "${DIR}/ca.pem.new" "${DIR}/ca.pem"
    rm -f "${DIR}/agent.crt" "${DIR}/agent.key"
    homelab-agent enroll -hub "${hub}" -dir "${DIR}" -code "${code}" \
        || bashio::exit.nok "Enrôlement refusé : jeton expiré ou déjà utilisé ? Génère une nouvelle commande d'installation depuis la fiche de l'hôte."
    printf '%s\n' "${hub}" > "${DIR}/hub_url"
    printf '%s\n' "${token_sum}" > "${DIR}/token.sha256"
fi

HUB_URL=$(cat "${DIR}/hub_url")
export HUB_URL AGENT_DIR="${DIR}" AGENT_STATE_DIR="${STATE}" AGENT_NO_SELFUPDATE=1
bashio::log.info "Agent $(homelab-agent -version), hub ${HUB_URL}"
exec homelab-agent
